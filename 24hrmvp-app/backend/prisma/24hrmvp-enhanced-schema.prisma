// ============================================
// PRICING CONFIGURATION (Stored in DB)
// ============================================

model VotePricing {
  id          String   @id @default(cuid())
  
  // Package details
  packageName String   @unique  // "single", "pack_5", "pack_20", "pack_100"
  voteCount   Int                // Number of votes in package
  
  // Pricing by currency
  priceUsd    Decimal  @db.Decimal(12, 2)
  priceUsdc   Decimal  @db.Decimal(12, 2)
  pricePoints Int
  
  // Stripe product IDs
  stripePriceId String?
  
  // Display
  displayName String
  description String?
  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false)
  
  // Metadata
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive, sortOrder])
}
