// 24HRMVP Production Database Schema
// Aligned with Foundation Architecture + FarCaster Optimization + Gamification
// + THE GRID Phase 1 (Social Aggregation, Forum, Moderation)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE USER MANAGEMENT
// ============================================

model User {
  id          String  @id @default(cuid())
  fid         Int     @unique
  username    String  @unique
  displayName String?
  pfpUrl      String?
  bio         String?

  custodyAddress String?
  verifications  String[]

  membershipTier String @default("free")
  points         Int    @default(0)
  reputation     Int    @default(0)
  level          Int    @default(1)

  isAdmin      Boolean   @default(false)
  isBanned     Boolean   @default(false)
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime?

  // Core relations
  ideas            Idea[]
  votes            Vote[]
  comments         Comment[]
  achievements     Achievement[]
  pointHistory     PointHistory[]
  streak           Streak?
  wallet           UserWallet?
  userAchievements UserAchievement[]
  userStreaks      UserStreak[]

  // THE GRID relations
  forumPosts     ForumPost[]       @relation("ForumPostAuthor")
  forumVotes     ForumPostVote[]   @relation("ForumVotes")
  forumBookmarks ForumBookmark[]   @relation("ForumBookmarks")
  moderatedPosts ForumPost[]       @relation("PostModerator")
  moderatedItems ModerationQueue[] @relation("ModerationReviewer")

  @@index([fid])
  @@index([username])
  @@index([points])
  @@index([reputation])
  @@index([createdAt])
}

model VotingCycle {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("active")

  winnerId String? @unique
  winner   Idea?   @relation("CycleWinner", fields: [winnerId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  ideas Idea[] @relation("CycleIdeas")

  @@index([status])
  @@index([startDate, endDate])
}

model Idea {
  id          String @id @default(cuid())
  title       String
  description String @db.Text
  category    String
  complexity  String

  tags        String[]
  attachments String[]

  status String @default("pending")

  voteCount  Int @default(0)
  voteWeight Int @default(0)

  submittedBy User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  votingCycle   VotingCycle @relation("CycleIdeas", fields: [votingCycleId], references: [id])
  votingCycleId String

  wonCycle VotingCycle? @relation("CycleWinner")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime?
  approvedAt    DateTime?
  implementedAt DateTime?

  votes      Vote[]
  comments   Comment[]
  mvpProject MVPProject?

  // THE GRID relation
  forumPosts ForumPost[] @relation("IdeaDiscussions")

  @@index([votingCycleId])
  @@index([userId])
  @@index([status])
  @@index([voteCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([category])
}

model Vote {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String

  weight Int @default(1)

  createdAt DateTime @default(now())

  @@unique([userId, ideaId])
  @@index([ideaId])
  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id      String @id @default(cuid())
  content String @db.Text

  parentId String?
  path     String  @db.VarChar(1000)
  depth    Int     @default(0)

  score Int @default(0)

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([ideaId, path])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
}

model MVPProject {
  id String @id @default(cuid())

  idea   Idea   @relation(fields: [ideaId], references: [id])
  ideaId String @unique

  repoUrl       String?
  deploymentUrl String?

  status   String @default("queued")
  progress Int    @default(0)

  logs         Json[]
  errorMessage String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSeenAt  DateTime?

  @@index([status])
  @@index([createdAt])
}

model Achievement {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type        String
  name        String
  description String
  iconUrl     String?

  rarity   String @default("common")
  xpReward Int    @default(0)

  earnedAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model PointHistory {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  points      Int
  action      String
  description String?

  sourceId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Streak {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  type           String
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActivityAt DateTime @default(now())

  @@index([userId])
}

model UserWallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance        Decimal @default(0) @db.Decimal(12, 2)
  lifetimeEarned Decimal @default(0) @db.Decimal(12, 2)

  transactions CurrencyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum TransactionType {
  EARN
  SPEND
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  REFUND
}

model CurrencyTransaction {
  id       String     @id @default(cuid())
  walletId String
  wallet   UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String?

  referenceType String?
  referenceId   String?
  balanceAfter  Decimal @db.Decimal(12, 2)
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt(sort: Desc)])
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model Badge {
  id            String      @id @default(cuid())
  name          String      @unique
  description   String
  iconUrl       String?
  category      String
  rarity        BadgeRarity @default(COMMON)
  pointsAwarded Int         @default(0)
  requirements  Json
  isActive      Boolean     @default(true)

  achievements UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
}

model UserAchievement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id])

  progress    Int       @default(0)
  targetValue Int
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, badgeId])
  @@index([userId, isCompleted])
}

model UserStreak {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           String
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActivityAt DateTime?
  nextDeadline   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

model LeaderboardEntry {
  id           String   @id @default(cuid())
  userId       String
  period       String
  category     String
  score        Decimal  @db.Decimal(12, 2)
  rank         Int?
  calculatedAt DateTime @default(now())

  @@unique([userId, period, category])
  @@index([period, category, score(sort: Desc)])
}

model NotificationToken {
  id String @id @default(cuid())

  userId          String
  token           String  @unique
  notificationUrl String
  enabled         Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Payment {
  id           String  @id @default(cuid())
  userId       String
  amount       Decimal @db.Decimal(12, 2)
  currency     String  @default("usd")
  status       String  @default("pending")
  provider     String
  providerTxId String? @unique
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerTxId])
}

// ============================================
// THE GRID - PHASE 1
// Social Aggregation, Forum, Moderation
// ============================================

// Grid-specific enums
enum SocialPlatform {
  FARCASTER
  TWITTER
  INSTAGRAM
  TIKTOK
}

enum PostType {
  DISCUSSION
  QUESTION
  ANNOUNCEMENT
  SHOWCASE
  FEEDBACK
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  ESCALATED
}

enum ModerationEntityType {
  SOCIAL_POST
  FORUM_POST
  COMMENT
  USER
}

// --------------------------------------------
// SOCIAL AGGREGATION
// --------------------------------------------

model SocialPost {
  id         String         @id @default(cuid())
  platform   SocialPlatform
  externalId String

  // Author info (denormalized for display)
  authorFid         Int?
  authorUsername    String
  authorDisplayName String?
  authorAvatar      String?

  // Content
  content   String   @db.Text
  mediaUrls String[]
  hashtags  String[]
  mentions  String[]

  // Farcaster-specific
  channelId  String?
  castHash   String?
  parentHash String?

  // Engagement (denormalized from source)
  likes       Int @default(0)
  reposts     Int @default(0)
  replies     Int @default(0)
  impressions Int @default(0)

  // URLs
  externalUrl String?

  // Moderation
  isHidden       Boolean @default(false)
  isFeatured     Boolean @default(false)
  moderationFlag String?

  // Timestamps
  publishedAt DateTime
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, externalId])
  @@index([platform, publishedAt(sort: Desc)])
  @@index([authorFid])
  @@index([channelId, publishedAt(sort: Desc)])
  @@index([isFeatured, publishedAt(sort: Desc)])
}

// --------------------------------------------
// FORUM / THREADED DISCUSSIONS
// --------------------------------------------

model ForumPost {
  id    String  @id @default(cuid())
  slug  String  @unique
  title String?

  // Content
  content     String  @db.Text
  contentHtml String? @db.Text

  // Type
  type PostType @default(DISCUSSION)

  // Author
  author   User   @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  // Threading (adjacency list)
  parentId String?
  parent   ForumPost?  @relation("ForumPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ForumPost[] @relation("ForumPostReplies")
  depth    Int         @default(0)

  // Link to idea (optional)
  idea   Idea?   @relation("IdeaDiscussions", fields: [ideaId], references: [id], onDelete: SetNull)
  ideaId String?

  // Voting (denormalized for performance)
  upvotes     Int   @default(0)
  downvotes   Int   @default(0)
  score       Int   @default(0)
  wilsonScore Float @default(0)
  hotScore    Float @default(0)

  // Metadata
  replyCount Int      @default(0)
  viewCount  Int      @default(0)
  tags       String[]

  // Status
  isPinned Boolean @default(false)
  isLocked Boolean @default(false)

  // Moderation
  moderationStatus ModerationStatus @default(APPROVED)
  moderatedBy      User?            @relation("PostModerator", fields: [moderatedById], references: [id])
  moderatedById    String?
  moderatedAt      DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastReplyAt DateTime?

  // Relations
  votes     ForumPostVote[] @relation("PostVotes")
  bookmarks ForumBookmark[] @relation("PostBookmarks")

  @@index([type, hotScore(sort: Desc)])
  @@index([type, wilsonScore(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([isPinned, hotScore(sort: Desc)])
  @@index([parentId])
  @@index([authorId])
  @@index([ideaId])
  @@index([moderationStatus])
}

model ForumPostVote {
  id String @id @default(cuid())

  user   User   @relation("ForumVotes", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  post   ForumPost @relation("PostVotes", fields: [postId], references: [id], onDelete: Cascade)
  postId String

  value Int // 1 for upvote, -1 for downvote

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model ForumBookmark {
  id String @id @default(cuid())

  user   User   @relation("ForumBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  post   ForumPost @relation("PostBookmarks", fields: [postId], references: [id], onDelete: Cascade)
  postId String

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
}

// --------------------------------------------
// CONTENT MODERATION
// --------------------------------------------

model ModerationQueue {
  id String @id @default(cuid())

  entityType ModerationEntityType
  entityId   String

  // AI moderation results
  aiScore      Float?
  aiCategories Json?
  aiReason     String?

  // Human review
  action       ModerationStatus @default(PENDING)
  reviewedBy   User?            @relation("ModerationReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewNotes  String?
  reviewedAt   DateTime?

  // User reports
  reportedBy   String?
  reportReason String?
  reportCount  Int     @default(1)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, action])
  @@index([reviewedById])
}
